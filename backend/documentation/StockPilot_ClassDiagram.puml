@startuml
title StockPilot - UML Class Diagram

skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 65
left to right direction

'=========================================================
' ENUMERATIONS
'=========================================================

enum UserRole {
  INVESTOR
  ANALYST
  ADMIN
}

enum SignalType {
  BUY
  HOLD
  SELL
}

enum TradeSide {
  BUY
  SELL
}

enum ListingStatus {
  DRAFT
  REVIEW
  VERIFIED
  LISTED
  REMOVED
}

enum NotificationKind {
  VERDICT_CHANGE
  PRICE_ALERT
  MARKETPLACE
  WEEKLY_REPORT
  SECURITY
  SYSTEM
}

'=========================================================
' DOMAIN CLASSES  (persistent entities)
'=========================================================

class User {
  -id : UUID {PK}
  -email : String {unique}
  -passwordHash : String
  -fullName : String
  -role : UserRole
  -phone : String
  -bio : String
  -avatarUrl : String
  -isActive : Boolean
  -createdAt : DateTime
  -updatedAt : DateTime
  --
  +register() : void
  +authenticate() : Boolean
  +updateProfile() : void
  +changePassword() : void
  +deactivateAccount() : void
}

class Holding {
  -id : UUID {PK}
  -ticker : String
  -quantity : double
  -avgCost : double
  -currentPrice : double
  -openedAt : DateTime
  -closedAt : DateTime
  --
  +calculateMarketValue() : double
  +calculateProfit() : double
  +updatePrice() : void
  +closeHolding() : void
}

class Watchlist {
  -id : UUID {PK}
  -ticker : String
  -addedAt : DateTime
  --
  +addTicker() : void
  +removeTicker() : void
}

class Trade {
  -id : UUID {PK}
  -ticker : String
  -side : TradeSide
  -entryPrice : double
  -exitPrice : double
  -stopLoss : double
  -takeProfit : double
  -quantity : double
  -strategyLabel : String
  -openedAt : DateTime
  -closedAt : DateTime
  -notes : String
  -createdAt : DateTime
  --
  +calculateProfit() : double
  +calculateRiskReward() : double
  +updateTrade() : void
}

class Strategy {
  -id : UUID {PK}
  -name : String
  -description : String
  -weights : JSON
  -isPreset : Boolean
  -isPublished : Boolean
  -createdAt : DateTime
  -updatedAt : DateTime
  --
  +createStrategy() : void
  +updateWeights() : void
  +validateWeights() : Boolean
  +requestPublication() : void
}

class MarketplaceListing {
  -id : UUID {PK}
  -priceCents : int
  -status : ListingStatus
  -avgRating : double
  -ratingCount : int
  -salesCount : int
  -backtestReturn : double
  -backtestSharpe : double
  -backtestWinrate : double
  -backtestTrades : int
  -backtestMaxDrawdown : double
  -backtestProfitFactor : double
  -listedAt : DateTime
  -createdAt : DateTime
  --
  +submitForReview() : void
  +approve() : void
  +reject() : void
  +remove() : void
  +recordSale() : void
  +calculateAverageRating() : double
}

class MarketplaceRating {
  -id : UUID {PK}
  -rating : int
  -review : String
  -createdAt : DateTime
  --
  +submitReview() : void
  +editReview() : void
}

class Notification {
  -id : UUID {PK}
  -kind : NotificationKind
  -title : String
  -body : String
  -isRead : Boolean
  -createdAt : DateTime
  --
  +markAsRead() : void
  +markAllAsRead() : void
}

class Stock {
  -id : UUID {PK}
  -ticker : String {unique}
  -name : String
  -sector : String
  -industry : String
  -updatedAt : DateTime
  --
  +updateInformation() : void
}

class PriceHistory {
  -ticker : String {PK}
  -date : Date {PK}
  -open : double
  -high : double
  -low : double
  -close : double
  -volume : long
  --
  +calculateReturn() : double
}

class Prediction {
  -id : UUID {PK}
  -ticker : String
  -signal : SignalType
  -confidence : double
  -probabilityUp : double
  -probabilityDown : double
  -compositeScore : int
  -modelVersion : String
  -createdAt : DateTime
}

class PlatformSettings <<singleton>> {
  -id : int {PK}
  -minTrades : int
  -minWinrate : double
  -minSharpe : double
  -maxDrawdown : double
  -minProfitFactor : double
  --
  +updateThresholds() : void
  +resetDefaults() : void
}

'=========================================================
' DATA LAYER SERVICES
'=========================================================

class DataFetcher {
  -dataPath : Path
  -defaultPeriod : String
  -defaultInterval : String
  -maxRetries : int
  -retryBackoff : double
  --
  +fetchHistorical() : DataFrame
  +saveToCSV() : Path
  +loadFromCSV() : DataFrame
  +fetchAndSave() : DataFrame
  +getAvailableTickers() : List
  +getDataSummary() : Map
}

class FeatureEngine {
  +calculateAllFeatures() : DataFrame
  +calculateMovingAverages() : DataFrame
  +calculateRSI() : DataFrame
  +calculateMACD() : DataFrame
  +calculateBollingerBands() : DataFrame
  +calculateVolumeIndicators() : DataFrame
  +calculateVolatility() : DataFrame
  +calculatePricePosition() : DataFrame
  +handleNaNValues() : DataFrame
  +validateData() : void
  +getFeatureNames() : List
}

class FinBERT <<module>> {
  +fetchNewsHeadlines() : List
  +analyzeHeadline() : HeadlineSentiment
  +analyzeTicker() : SentimentResult
}

'=========================================================
' AI / ANALYTICS SERVICES
'   NOTE: two INDEPENDENT engines exist.
'   1) FactorAnalysisService - explainable six-factor verdict (user facing)
'   2) StockPredictor        - XGBoost probabilistic signal
'=========================================================

class FactorAnalysisService <<service>> {
  +computeFactorScores() : Map
  +computeDailyComposite() : Series
  +generateVerdict() : Verdict
  +runBacktest() : BacktestMetrics
  +generateBullBear() : Pair
}

class StockPredictor <<service>> {
  -model : XGBClassifier
  -config : PredictorConfig
  -featureColumns : List
  --
  +prepareData() : Pair
  +train() : XGBClassifier
  +walkForwardEvaluate() : WalkForwardReport
  +evaluate() : Map
  +backtest() : BacktestReport
  +predict() : Map
  +saveModel() : Path
  +loadModel() : void
}

class PredictorConfig <<dataclass>> {
  -targetHorizon : int
  -targetDeadband : double
  -trainingPeriod : String
  -stationaryOnly : Boolean
  -maxEstimators : int
  -earlyStoppingRounds : int
  -maxDepth : int
  -learningRate : double
  -holdLower : double
  -holdUpper : double
}

class BacktestReport <<dataclass>> {
  +asDict() : Map
}

class WalkForwardReport <<dataclass>> {
  -nSplits : int
  -meanAccuracy : double
  -stdAccuracy : double
  -meanLogloss : double
}

'=========================================================
' COMPOSITIONS - user-owned data
'   These entities have a single non-null owner FK and are
'   cascade-deleted with the user (delete-orphan), so their
'   lifecycle is bound to the User: composition (filled diamond).
'=========================================================

User "1" *-- "0..*" Holding : owns >
User "1" *-- "0..*" Watchlist : monitors >
User "1" *-- "0..*" Trade : logs >
User "1" *-- "0..*" Notification : receives >

'=========================================================
' AGGREGATION - strategies
'   A preset strategy has NO owner (owner_id nullable), so a
'   Strategy can exist without a User: aggregation, owner 0..1.
'=========================================================

User "0..1" o-- "0..*" Strategy : creates >

'=========================================================
' ASSOCIATIONS - marketplace
'   MarketplaceRating is an association class resolving the
'   many-to-many between User and MarketplaceListing, so it is
'   linked by plain associations rather than composition.
'   A listing cannot exist without its strategy (FK RESTRICT),
'   therefore Strategy--Listing is a composition.
'=========================================================

Strategy "1" *-- "0..1" MarketplaceListing : published as >
MarketplaceListing "1" -- "0..*" MarketplaceRating : receives >
User "1" -- "0..*" MarketplaceRating : writes >

'=========================================================
' LOGICAL LINKS (no foreign key)
'   These entities reference instruments by TICKER STRING only,
'   so the link is logical, not referential. Shown dashed.
'=========================================================

Stock .. PriceHistory : linked by ticker >
Stock .. Prediction : linked by ticker >
Stock .. Holding : linked by ticker >
Stock .. Watchlist : linked by ticker >
Stock .. Trade : linked by ticker >

'=========================================================
' ENUM USAGE
'=========================================================

User ..> UserRole
Trade ..> TradeSide
Prediction ..> SignalType
MarketplaceListing ..> ListingStatus
Notification ..> NotificationKind

'=========================================================
' SERVICE RELATIONSHIPS
'=========================================================

' --- Six-factor engine (explainable verdict + backtest) ---
FactorAnalysisService ..> DataFetcher : uses
FactorAnalysisService ..> FeatureEngine : uses
FactorAnalysisService ..> FinBERT : uses
FactorAnalysisService ..> Strategy : reads weights
FactorAnalysisService ..> PlatformSettings : reads thresholds

' --- XGBoost engine (probabilistic signal) ---
StockPredictor *-- PredictorConfig
StockPredictor ..> DataFetcher : uses
StockPredictor ..> FeatureEngine : uses
StockPredictor ..> Prediction : persists
StockPredictor ..> BacktestReport : produces
StockPredictor ..> WalkForwardReport : produces

note bottom of FinBERT
  Used ONLY by the six-factor engine.
  The XGBoost predictor does not use
  sentiment - its backtest substitutes
  an OBV trend proxy.
end note

note bottom of PlatformSettings
  Singleton row (id = 1) holding the five
  marketplace approval thresholds.
  Editable by an administrator at runtime.
end note

@enduml
